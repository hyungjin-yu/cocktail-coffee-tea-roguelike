# OS
.DS_Store
Thumbs.db

# Crashlytics
crashlytics-build.properties

# Packages (lock file kept, cache not needed)
/[Pp]ackages/*
!/[Pp]ackages/manifest.json
!/[Pp]ackages/packages-lock.json

# Generated delivery evidence and packaged players
/Delivery/**
!/Delivery/*.md
!/Delivery/Reports/
!/Delivery/Reports/*.md

# Temporary Unity test scenes
/Assets/InitTestScene*.unity
/Assets/InitTestScene*.unity.meta

# Local credentials and saves
.env
.env.*
*.pem
*.key
save.json
settings.json
guest_session.json
commerce.json
commerce.json.bak
commerce.json.tmp

# Android signing and server credentials stay outside source control
*.keystore
*.jks
service-account*.json
credentials*.json
__pycache__/
.venv/

# Android signing (2026-10-12): never commit upload keys or their passwords
*.p12
keystore.properties
*.apk
*.aab
